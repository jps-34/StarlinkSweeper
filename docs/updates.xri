<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>StarlinkSweeper: finds the light frames crossed by satellite trails.</p>
      <p>Add https://jps-34.github.io/StarlinkSweeper/ under Resources &gt; Updates &gt; Manage Repositories.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="StarlinkSweeper-1.3.1-PI194.zip" sha1="b4e6e591acbd4f5e3b5869ae15e2a73a64c6e2e7" type="script" releaseDate="20261030" serverURL="https://jps-34.github.io/StarlinkSweeper/">
         <title>StarlinkSweeper 1.3.1 (PixInsight 1.9.4 and later)</title>
         <description>
            <p>Scans a folder tree of light frames (FITS / XISF) for satellite, Starlink train and aircraft trails, lists the affected frames with a score, shows each detection on a preview, and lets you quarantine (move to a &lt;folder&gt;_trails folder next to the scanned one) or erase them one by one with confirmation. With WBPP, the frames can be kept instead: the event script StarlinkSweeper-WBPP.js masks only the pixels of the trails in the registered frames. Parallel scan on all the processors with PixInsight 1.9.5 and later. Installs under Script &gt; JPS &gt; StarlinkSweeper.</p>
            <p>Copyright (c) 2026 Jacques Pouyaud. GNU GPL v3 or later. Source: https://github.com/jps-34/StarlinkSweeper</p>
         </description>
      </package>
   </platform>
</xri>
