<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>StarlinkSweeper: finds the light frames crossed by satellite trails.</p>
      <p>Add https://jps-34.github.io/StarlinkSweeper/ under Resources &gt; Updates &gt; Manage Repositories.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="StarlinkSweeper-1.2.1-PI194.zip" sha1="3e59f29c2aa0b04ea438269bf5148f92eaeb6cf8" type="script" releaseDate="20261027" serverURL="https://jps-34.github.io/StarlinkSweeper/">
         <title>StarlinkSweeper 1.2.1 (PixInsight 1.9.4 and later)</title>
         <description>
            <p>Scans a folder tree of light frames (FITS / XISF) for satellite, Starlink train and aircraft trails, lists the affected frames with a score, shows each detection on a preview, and lets you quarantine (move to a &lt;folder&gt;_trails folder next to the scanned one) or erase them one by one with confirmation. Parallel scan on all the processors with PixInsight 1.9.5 and later. Installs under Script &gt; Utilities &gt; StarlinkSweeper.</p>
            <p>Copyright (c) 2026 Jacques Pouyaud. GNU GPL v3 or later. Source: https://github.com/jps-34/StarlinkSweeper</p>
         </description>
      </package>
   </platform>
</xri>
